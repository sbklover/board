<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.board.board.mapper.BoardMapper">
    <select id="listAll" parameterType="String">
        SELECT *
        FROM board
    </select>

    <!-- 페이징된 목록 조회 (최신글이 위로 오도록 no 내림차순) -->
    <select id="boardListPaged" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        ORDER BY no DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 전체 게시글 개수 (페이징 계산용) -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM board
    </select>

    <insert id="InsertBoard">
        INSERT INTO board (id, title, content)
        VALUES ('None', #{title}, #{content})
    </insert>

    <select id="boardView" parameterType="Long" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        WHERE no = #{no}
    </select>

    <update id="boardModify">
        UPDATE board
        SET title=#{title},
            content=#{content}
        WHERE no = #{no}
    </update>

    <delete id="boardDelete">
        DELETE
        FROM board
        WHERE no = #{no}
    </delete>
</mapper>