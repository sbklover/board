<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.board.board.mapper.BoardMapper">
    <!-- id별 조회 -->
    <select id="listAll" parameterType="String" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        WHERE id = #{id}
    </select>

    <!-- 새 글 입력 -->
    <insert id="InsertBoard">
        INSERT INTO board (id, title, content)
        VALUES (#{id}, #{title}, #{content})
    </insert>

    <!-- 글 1건 조회 -->
    <select id="boardView" parameterType="Long" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        WHERE no = #{no}
    </select>

    <!-- 글 삭제 -->
    <update id="boardModify">
        UPDATE board
        SET title = #{title},
            content = #{content}
        WHERE no = #{no}
    </update>

    <!-- 글 삭제 -->
    <delete id="boardDelete">
        DELETE
        FROM board
        WHERE no = #{no}
    </delete>

    <!-- 페이징된 목록 조회 (최신글이 위로 오도록 no 내림차순) -->
    <select id="boardListPaged" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        ORDER BY no DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 전체 게시글 개수 (페이징 계산용) -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM board
    </select>

    <!-- id(작성자)별 페이징 목록 조회 (최신글이 위로 오도록 no 내림차순) -->
    <select id="boardListPagedById" resultType="com.board.board.dto.Board">
        SELECT *
        FROM board
        WHERE id = #{id}
        ORDER BY no DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- id(작성자)별 게시글 개수 (페이징 계산용) -->
    <select id="countById" parameterType="String" resultType="int">
        SELECT COUNT(*)
        FROM board
        WHERE id = #{id}
    </select>
</mapper>